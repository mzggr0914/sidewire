{
  "name": "sidewire-tooling",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,css,html,json,yml,yaml,md,java,sh}\" module/bin/sidewirectl",
    "format:check": "prettier --check \"**/*.{js,css,html,json,yml,yaml,md,java,sh}\" module/bin/sidewirectl"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "prettier-plugin-sh": "0.20.2"
  }
}

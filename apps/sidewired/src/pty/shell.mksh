# mksh has opened the per-session startup file under the requested identity.
/system/bin/rm -f -- "$ENV"
if [[ -n ${SIDEWIRE_SAVED_ENV-} ]]; then
    ENV=$SIDEWIRE_SAVED_ENV
    [[ ! -r $ENV ]] || . "$ENV"
else
    unset ENV
    [[ ! -r /system/etc/mkshrc ]] || . /system/etc/mkshrc
fi
__sw_tty=$SIDEWIRE_PROMPT_TTY
unset SIDEWIRE_SAVED_ENV SIDEWIRE_PROMPT_TTY
set +o emacs
set +o vi
stty iutf8 2>/dev/null

# The daemon only queues a private parser token while the shell is stopped
# here or in __sw_read. It restores the PTY before releasing either gate.
function __sw_gate {
    builtin unalias __sw_run 2>/dev/null
    builtin print -nru9 -- P
    IFS= builtin read -ru9 __sw_show_prompt || exit
}
function __sw_read {
    typeset previous=$1 command
    builtin print -nru9 -- R
    IFS= builtin read -ru9 command || exit
    case $command in
        L*) builtin alias "__sw_run=${command#L}" ;;
        C) return 130 ;;
        D) exit "$previous" ;;
        F) ;;
        *) exit 1 ;;
    esac
    # The internal read is one shell command. Hide its prompt and restore
    # the real PS1 before the user's command is parsed at top level.
    __sw_saved_ps1=$PS1
    PS1='${| typeset __sw_rc=$?; PS1=$__sw_saved_ps1; REPLY=; return "$__sw_rc"; }'
    return "$previous"
}
# Queued lines were already echoed by the PTY. Only display a primary
# prompt when there is no completed command waiting to run.
PS1='${| typeset __sw_rc=$?; __sw_gate 9<>"$__sw_tty"; REPLY=; return "$__sw_rc"; }${__sw_show_prompt:+'"$PS1"'}'
